# Copie pra .env (ignorado pelo git) e preencha com os valores reais.
# Ver src/services/firebase_settings.ts — dados do projeto Firebase
# "potterpg" (console.firebase.google.com, Configurações do projeto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Chave do Gemini — ainda sem uso no código, reservada pro step 4 do
# wizard de criação de personagem. Sem prefixo VITE_ de propósito (não
# pode ir pro bundle do client).
GEMINI_KEY=
